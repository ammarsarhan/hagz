generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum BookingActor {
  USER
  STAFF
}

enum StaffRole {
  MANAGER
  OWNER
}

enum Language {
  EN
  AR
}

enum Country {
  EG
}

enum AmenityName {
  LIGHTING
  SEATING
  LOCKER_ROOMS
  SHOWERS
  TOILETS
  PARKING
  AIR_CONDITIONED
  HEATING
  SOUND_SYSTEM
  WATER_FOUNTAIN
  WIFI
  BALL_INCLUDED
  EQUIPMENT_RENTAL
  FIRST_AID
  REFEREE_SERVICE
  CAFETERIA
}

enum AmenityPrice {
  PER_HOUR
  PER_BOOKING
}

enum BookingStatus {
  RESERVED
  CONFIRMED
  EXPIRED
  CANCELLED
  RESCHEDULED
  IN_PROGRESS
  NO_SHOW
  COMPLETED
}

enum BookingChannel {
  ONLINE
  WALK_IN
}

enum PitchStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  LIVE
  MAINTENANCE
  DELETED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING
  UPLOADED
  DELETED
}

enum GroundStatus {
  ACTIVE
  MAINTENANCE
  DELETED
}

enum GroundSurface {
  NATURAL_GRASS
  ARTIFICIAL_TURF
  HARD_WOOD
  OTHER
}

enum GroundSport {
  FOOTBALL
  BASKETBALL
  PADEL
  TENNIS
  VOLLEYBALL
}

enum GroundSize {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
  STANDARD
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  INACTIVE
}

enum PriceType {
  BASE
  PEAK
  DISCOUNT
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  WALLET
}

enum PayoutTrigger {
  MANUAL
  SCHEDULED
}

// Update later to mimic methods better
enum PayoutMethod {
  BANK_TRANSFER
  WALLET
  MANUAL
}

enum LedgerAction {
  BOOKING_REVENUE // Owner's share of a booking
  PLATFORM_FEE_DEBIT // Platform's 5% cut deducted from owner
  SERVICE_FEE_CREDIT // Service fee collected from user (platform's)
  CASH_FEE_DEBT // Platform fee owed from a cash booking (not yet settled)
  PAYOUT // A payout was issued
  PAYOUT_REVERSAL // A payout was reversed/failed
  ADJUSTMENT // Manual correction
}

enum ScheduleStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSED
  FORFEITED
}

enum InvitationStatus {
  PENDING
  EXPIRED
  ACCEPTED
  REJECTED
  DELETED
}

enum RecurringPaymentSchedule {
  UPFRONT
  PER_BOOKING
}

enum GroundActions {
  BOOKED
  RESCHEDULED
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  IN_APP
  PUSH
  WHATSAPP
  EMAIL
}

enum NotificationEvent {
  BOOKING_RESERVED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_REMINDER
  BOOKING_STARTED
  BOOKING_EXPIRED
  BOOKING_NO_SHOW
  PAYOUT_PROCESSED
  PAYOUT_FAILED
  INVITATION_CREATED
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  PITCH_UPDATED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum PermissionLevel {
  NONE
  READ
  WRITE
}

model Session {
  id           String @id @default(cuid())
  refreshToken String @unique
  userId       String
  user         User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String  @unique
  email     String? @unique
  password  String

  street  String?
  area    String?
  city    String?
  country Country? @default(EG)

  sessions   Session[]
  isVerified Boolean    @default(false)
  status     UserStatus @default(ACTIVE)

  profiles      PitchCustomer[]
  bookings      Booking[]
  pitches       Staff[]
  reschedulings Rescheduling[]
  cancellations Cancellation[]

  preferences        UserPreferences?
  notifications      Notification[]
  payoutDestinations PayoutDestination[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserPreferences {
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  language      Language             @default(EN)
  notifications NotificationChannel[] @default([WHATSAPP])
  paymentMethod PaymentMethod        @default(CASH)
  timezone      String               @default("Africa/Cairo")
}

model Staff {
  userId      String
  pitchId     String
  role        StaffRole
  permissions Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pitch       Pitch        @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  events      PitchEvent[]
  invitations Invitation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@id([userId, pitchId])
}

model PitchEvent {
  id      String @id @default(cuid())
  pitch   Pitch  @relation(fields: [pitchId], references: [id])
  pitchId String

  status  PitchStatus
  actorId String?
  actor   Staff?      @relation(fields: [actorId, pitchId], references: [userId, pitchId])
  reason  String?

  createdAt DateTime @default(now())
}

model PitchMedia {
  id      String @id @default(cuid())
  pitchId String
  pitch   Pitch  @relation(fields: [pitchId], references: [id])

  key         String
  url         String
  type        MediaType   @default(IMAGE)
  contentType String
  status      MediaStatus @default(PENDING)
  order       Int         @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pitchId, order])
  @@index([pitchId])
}

model Pitch {
  id          String  @id @default(cuid())
  name        String
  description String
  taxId       String?

  street         String
  area           String
  city           String
  country        Country
  latitude       Float
  longitude      Float
  googleMapsLink String
  media          PitchMedia[]

  status PitchStatus  @default(DRAFT)
  events PitchEvent[]

  amenityList  AmenityName[]
  sports       GroundSport[]
  sizes        GroundSize[]
  minimumPrice Int?
  maximumPrice Int?

  staff        Staff[]
  amenities    Amenity[]
  grounds      Ground[]
  combinations Combination[]
  invitations  Invitation[]
  bookings     Booking[]
  customers    PitchCustomer[]
  ledger       PitchLedger?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ground {
  id      String @id @default(cuid())
  pitchId String

  name        String
  description String?
  sport       GroundSport
  surface     GroundSurface
  size        GroundSize
  settings    GroundSettings?

  status GroundStatus @default(ACTIVE)

  basePrice     Int
  peakPrice     Int?
  discountPrice Int?

  combinations CombinationGround[]
  bookings     Booking[]
  slots        GroundSlot[]

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  schedule          Schedule[]
  scheduleOverrides ScheduleOverride[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model GroundSettings {
  id       String @id @default(cuid())
  groundId String @unique
  ground   Ground @relation(fields: [groundId], references: [id])

  minimumDuration Int @default(1) // Hours
  maximumDuration Int @default(6) // Hours
  minimumWindow   Int @default(2) // Hours
  maximumWindow   Int @default(2160) // Hours

  autoConfirm            Boolean @default(true)
  allowGuestBookings     Boolean @default(true)
  allowRecurringBookings Boolean @default(true)
  maxRecurringSessions   Int?

  paymentMethods    PaymentMethod[] @default([CASH])
  allowDeposit      Boolean         @default(false)
  depositPercentage Int?

  approvalExpiryLimit Int @default(30) // Minutes
  paymentExpiryLimit Int @default(15) // Minutes

  allowRescheduling Boolean @default(true)
  rescheduleLimit   Int     @default(24) // Hours

  fullRefundWindow    Int @default(48) // Hours
  partialRefundWindow Int @default(24) // Hours
  refundPercentage    Int @default(50)

  notificationsTrigger GroundActions[] @default([BOOKED, CANCELLED, RESCHEDULED])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CombinationGround {
  combinationId String
  groundId      String

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  ground      Ground      @relation(fields: [groundId], references: [id], onDelete: Restrict)

  @@id([combinationId, groundId])
}

model Combination {
  id      String @id @default(cuid())
  pitchId String
  pitch   Pitch  @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  name     String
  grounds  CombinationGround[]
  size     GroundSize
  isActive Boolean             @default(true)
  bookings GroupBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Amenity {
  pitchId     String
  order       Int
  name        AmenityName
  description String?
  price       Int?
  unit        AmenityPrice?

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@id([pitchId, order])
}

model Invitation {
  id      String @id @default(cuid())
  pitchId String
  pitch   Pitch  @relation(fields: [pitchId], references: [id])

  name   String
  phone  String
  token  String           @unique
  status InvitationStatus @default(PENDING)
  
  expiresAt  DateTime
  acceptedAt DateTime?
  rejectedAt DateTime?

  creatorId String
  creator   Staff    @relation(fields: [creatorId, pitchId], references: [userId, pitchId])
  createdAt DateTime @default(now())

  @@unique([pitchId, phone, status])
}

model GroundSlot {
  id String @id @default(cuid())

  pitchId  String // Intentionally denormalized for query performance
  groundId String
  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  startsAt  DateTime
  status    SlotStatus @default(AVAILABLE)
  priceType PriceType  @default(BASE)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@unique([groundId, startsAt])
}

model Schedule {
  id       String @id @default(cuid())
  groundId String
  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  dayOfWeek     Int
  baseHours     Bytes
  peakHours     Bytes
  discountHours Bytes

  status          ScheduleStatus @default(PENDING)
  isActive        Boolean        @default(true)
  lastGeneratedAt DateTime?

  @@unique([groundId, dayOfWeek])
}

model ScheduleOverride {
  id       String @id @default(cuid())
  groundId String
  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  date           DateTime @db.Date
  operatingHours Bytes
  reason         String?

  @@unique([groundId, date])
}

model GroupBooking {
  id            String      @id @default(cuid())
  bookings      Booking[]
  combinationId String
  combination   Combination @relation(fields: [combinationId], references: [id])
}

model RecurringBooking {
  id String @id @default(cuid())

  interval        Int
  endDate         DateTime
  paymentSchedule RecurringPaymentSchedule

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PitchCustomer {
  id      String @id @default(cuid())
  pitchId String
  pitch   Pitch  @relation(fields: [pitchId], references: [id])

  firstName String?
  lastName  String?
  phone     String

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([pitchId, phone])
}

model Booking {
  id       String @id @default(cuid())
  pitchId  String
  groundId String

  pitch         Pitch         @relation(fields: [pitchId], references: [id])
  ground        Ground        @relation(fields: [groundId], references: [id])
  slots         GroundSlot[]
  payment       Payment?
  ledgerEntries LedgerEntry[]
  events        BookingEvent[]

  customerId  String
  customer    PitchCustomer @relation(fields: [customerId], references: [id])
  initiatorId String
  initiator   User          @relation(fields: [initiatorId], references: [id])
  bookerRole  BookingActor
  isApproved  Boolean

  startTime       DateTime
  endTime         DateTime
  channel         BookingChannel
  pricingSnapshot Json
  depositFee      Int?
  totalAmount     Int
  paymentMethod   PaymentMethod

  status BookingStatus @default(RESERVED)

  groupBookingId     String?
  groupBooking       GroupBooking?     @relation(fields: [groupBookingId], references: [id])
  recurringBookingId String?
  recurringBooking   RecurringBooking? @relation(fields: [recurringBookingId], references: [id])

  rescheduledFrom Rescheduling? @relation("rescheduledFrom")
  rescheduledTo   Rescheduling? @relation("rescheduledTo")
  cancellation    Cancellation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingEvent {
  id        String @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String

  previousStatus  BookingStatus
  updatedStatus   BookingStatus
  logs  String?

  createdAt DateTime @default(now())
}

model Rescheduling {
  id     String  @id @default(cuid())
  fromId String  @unique
  toId   String  @unique
  from   Booking @relation("rescheduledFrom", fields: [fromId], references: [id])
  to     Booking @relation("rescheduledTo", fields: [toId], references: [id])

  userRole    BookingActor
  initiatorId String
  initiator   User         @relation(fields: [initiatorId], references: [id])
  reason      String?

  refundDelta   Int?
  rescheduledAt DateTime @default(now())
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  method  PaymentMethod
  total   Int
  deposit Int?

  transactionRef String?

  refundStatus    RefundStatus @default(NOT_APPLICABLE)
  refundAmount    Int?
  refundReference String?
  refundedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cancellation {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  initiatorId String
  initiator   User         @relation(fields: [initiatorId], references: [id])
  actor       BookingActor

  reason      String?
  cancelledAt DateTime @default(now())
}

model LedgerEntry {
  id       String      @id @default(cuid())
  ledgerId String
  ledger   PitchLedger @relation(fields: [ledgerId], references: [id])

  type      LedgerAction
  amount    Int // Positive = owed to owner, negative = owed to platform
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  payoutId  String?
  payout    Payout?      @relation(fields: [payoutId], references: [id])

  note      String?
  createdAt DateTime @default(now())
}

model PitchLedger {
  id      String @id @default(cuid())
  pitchId String @unique
  pitch   Pitch  @relation(fields: [pitchId], references: [id])

  balance Int @default(0)

  entries LedgerEntry[]
  payouts Payout[]

  updatedAt DateTime @updatedAt
}

model Payout {
  id       String      @id @default(cuid())
  ledgerId String
  ledger   PitchLedger @relation(fields: [ledgerId], references: [id])

  entries LedgerEntry[]

  amount         Int
  method         PayoutMethod
  trigger        PayoutTrigger
  status         PayoutStatus  @default(PENDING)
  transactionRef String?

  destinationId String
  destination   PayoutDestination @relation(fields: [destinationId], references: [id])

  requestedAt   DateTime  @default(now())
  processedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
}

model PayoutDestination {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  payouts Payout[]

  method      PayoutMethod
  accountName String
  accountRef  String
  isDefault   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id])
  phone String?

  event NotificationEvent
  deliveries NotificationDelivery[]

  title String?
  body  String?
  payload Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
}

model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  status  NotificationStatus @default(PENDING)

  template    String?
  variables   Json?
  providerRef String?

  scheduledAt DateTime @default(now())
  sentAt      DateTime?

  error String?

  @@unique([notificationId, channel])
}