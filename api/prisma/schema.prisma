generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENED
  BANNED
  DELETED
}

enum BookingActor {
  USER
  MANAGER
  OWNER
}

enum PermissionsRole {
  MANAGER
  OWNER
}

enum Language {
  EN
  AR
}

enum Country {
  EG
}

enum AmenityName {
  LIGHTING
  SEATING
  LOCKER_ROOMS
  SHOWERS
  TOILETS
  PARKING
  AIR_CONDITIONED
  HEATING
  SOUND_SYSTEM
  WATER_FOUNTAIN
  WIFI
  BALL_INCLUDED
  EQUIPMENT_RENTAL
  FIRST_AID
  REFEREE_SERVICE
  CAFETERIA
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  NO_SHOW
  CANCELLED
  COMPLETED
}

enum PitchStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  LIVE
  MAINTENANCE
  DELETED
}

enum GroundStatus {
  ACTIVE
  MAINTENANCE
  DELETED
}

enum GroundSurface {
  NATURAL_GRASS
  ARTIFICIAL_TURF
  HARD_WOOD
  OTHER
}

enum GroundSport {
  FOOTBALL
  BASKETBALL
  PADEL
  TENNIS
  VOLLEYBALL
}

enum GroundSize {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
  STANDARD
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  INACTIVE
}

enum PriceType {
  BASE
  PEAK
  DISCOUNT
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  WALLET
}

enum RefundStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSED
  FORFEITED
}

enum InvitationStatus {
  PENDING
  EXPIRED
  ACCEPTED
  REJECTED
}

enum RecurringPaymentSchedule {
  UPFRONT
  PER_BOOKING
}

enum NotificationMethod {
  SMS
  WHATSAPP
  EMAIL
}

enum GroundActions {
  BOOKED
  RESCHEDULED
  CANCELLED
  EXPIRED
}

model Session {
  id           String @id @default(cuid())
  refreshToken String @unique
  userId       String
  user         User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String @unique
  password  String

  street  String?
  area    String?
  city    String?
  country Country? @default(EG)

  sessions   Session[]
  isVerified Boolean    @default(false)
  status     UserStatus @default(ACTIVE)

  pitches         PitchPermissions[]
  bookings        Booking[]
  createdBookings Booking[]          @relation("createdBookings")
  reschedulings   Rescheduling[]
  cancellations   Cancellation[]

  preferences UserPreferences?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserPreferences {
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  language      Language             @default(EN)
  notifications NotificationMethod[] @default([WHATSAPP])
  paymentMethod PaymentMethod        @default(CASH)
  timezone      String               @default("Africa/Cairo")
}

model PitchPermissions {
  userId      String
  pitchId     String
  permissions Json
  role        PermissionsRole

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, pitchId])
}

model Pitch {
  id          String  @id @default(cuid())
  name        String
  description String
  taxId       String?

  street         String
  area           String
  city           String
  country        Country
  latitude       Float
  longitude      Float
  googleMapsLink String
  amenityList    AmenityName[]
  images         String[]

  status PitchStatus @default(DRAFT)

  layout       Json
  sports       GroundSport[]
  sizes        GroundSize[]
  minimumPrice Int
  maximumPrice Int

  permissions PitchPermissions[]
  amenities   Amenity[]
  grounds     Ground[]
  invitations Invitation[]
  bookings    Booking[]

  rejectionReason String?
  reviewedBy      String?

  approvedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  combinations Combination[]
}

model Ground {
  id      String @id @default(cuid())
  pitchId String

  name         String
  description  String?
  images       String[]
  sport        GroundSport
  surface      GroundSurface
  size         GroundSize
  combinations CombinationGround[]
  settings     GroundSettings?

  status GroundStatus

  basePrice      Int
  peakPrice      Int?
  discountPrice  Int?

  bookings Booking[]
  slots    GroundSlot[]

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  schedule          Schedule[]
  scheduleOverrides ScheduleOverride[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model GroundSettings {
  groundId String @unique
  ground   Ground  @relation(fields: [groundId], references: [id])

  minimumDuration Int @default(1) // Hours
  maximumDuration Int @default(6) // Hours
  minimumWindow Int @default(2) // Hours
  maximumWindow Int @default(720) // Hours

  autoConfirm Boolean @default(true)
  allowGuestBookings Boolean @default(true)
  allowRecurringBookings Boolean @default(true)
  maxRecurringInterval       Int?

  paymentMethods PaymentMethod[] @default([CASH])
  allowDeposit Boolean @default(false)
  depositPercentage      Int?

  autoExpiryLimit Int @default(30) // Minutes

  allowRescheduling      Boolean @default(true)
  rescheduleLimit     Int     @default(24) // Hours

  fullRefundWindow Int @default(48) // Hours
  partialRefundWindow Int @default(24) // Hours
  refundPercentage Int @default(50)

  notificationsTrigger GroundActions[] @default([BOOKED, CANCELLED, RESCHEDULED])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CombinationGround {
  combinationId String
  groundId      String

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  ground      Ground      @relation(fields: [groundId], references: [id], onDelete: Restrict)

  @@id([combinationId, groundId])
}

model Combination {
  id      String @id @default(cuid())
  pitchId String
  pitch   Pitch  @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  name     String
  grounds  CombinationGround[]
  size     GroundSize
  isActive Boolean             @default(true)
  bookings GroupBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Amenity {
  pitchId     String
  order       Int
  name        AmenityName
  description String?
  isPaid      Boolean     @default(false)
  price       Int?

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@id([pitchId, order])
}

model Invitation {
  id      String @id @default(cuid())
  pitchId String

  pitch  Pitch            @relation(fields: [pitchId], references: [id])
  phone  String
  status InvitationStatus @default(PENDING)

  expiresAt  DateTime
  acceptedAt DateTime?
  rejectedAt DateTime?

  createdBy String
  createdAt DateTime @default(now())
}

model GroundSlot {
  id String @id @default(cuid())

  pitchId  String
  groundId String
  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  date     DateTime @db.Date
  startsAt DateTime
  endsAt   DateTime

  status    SlotStatus @default(AVAILABLE)
  priceType PriceType  @default(BASE)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@unique([groundId, startsAt])
}

model Schedule {
  id       String @id @default(cuid())
  groundId String
  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  dayOfWeek      Int
  operatingHours Bytes
  peakHours      Bytes
  discountHours  Bytes

  isActive Boolean @default(true)

  @@unique([groundId, dayOfWeek])
}

model ScheduleOverride {
  id       String @id @default(cuid())
  groundId String
  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  date           DateTime @db.Date
  operatingHours Bytes
  reason         String?

  @@unique([groundId, date])
}

model GroupBooking {
  id            String      @id @default(cuid())
  bookings      Booking[]
  combinationId String
  combination   Combination @relation(fields: [combinationId], references: [id])
}

model RecurringBooking {
  id String @id @default(cuid())

  interval        Int
  endDate         DateTime
  paymentSchedule RecurringPaymentSchedule

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id       String @id @default(cuid())
  pitchId  String
  groundId String

  pitch   Pitch        @relation(fields: [pitchId], references: [id])
  ground  Ground       @relation(fields: [groundId], references: [id])
  slots   GroundSlot[]
  payment Payment?

  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  guestPhone String?

  bookerId   String
  bookedBy   User         @relation("createdBookings", fields: [bookerId], references: [id])
  bookerRole BookingActor

  startTime       DateTime
  endTime         DateTime
  pricingSnapshot Json
  depositFee      Int?
  totalAmount     Int

  paymentMethod PaymentMethod
  status        BookingStatus @default(PENDING)

  groupBookingId     String?
  groupBooking       GroupBooking?     @relation(fields: [groupBookingId], references: [id])
  recurringBookingId String?
  recurringBooking   RecurringBooking? @relation(fields: [recurringBookingId], references: [id])

  rescheduledFrom Rescheduling? @relation("rescheduledFrom")
  rescheduledTo   Rescheduling? @relation("rescheduledTo")
  cancellation    Cancellation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rescheduling {
  id     String  @id @default(cuid())
  fromId String  @unique
  toId   String  @unique
  from   Booking @relation("rescheduledFrom", fields: [fromId], references: [id])
  to     Booking @relation("rescheduledTo", fields: [toId], references: [id])

  userRole BookingActor
  userId   String
  user     User         @relation(fields: [userId], references: [id])
  reason   String?

  refundDelta   Int?
  rescheduledAt DateTime @default(now())
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  method  PaymentMethod
  total   Int
  deposit Int?

  transactionRef String?

  refundStatus    RefundStatus @default(NOT_APPLICABLE)
  refundAmount    Int?
  refundReference String?
  refundedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cancellation {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  userId String
  user   User         @relation(fields: [userId], references: [id])
  actor  BookingActor

  reason      String?
  cancelledAt DateTime @default(now())
}
