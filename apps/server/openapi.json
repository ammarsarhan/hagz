{
  "openapi": "3.1.0",
  "info": {
    "title": "Hagz API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "customerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "The access token from sign-up, sign-in or refresh."
      }
    },
    "schemas": {
      "Marketplace": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "ISO 3166-1 alpha-2.",
            "example": "EG"
          },
          "name": {
            "type": "string",
            "description": "In the requested language.",
            "example": "مصر"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "ISO 4217.",
            "example": "EGP"
          },
          "dialCode": {
            "type": "string",
            "description": "E.164 prefix.",
            "example": "+20"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone.",
            "example": "Africa/Cairo"
          }
        },
        "required": [
          "code",
          "name",
          "currency",
          "dialCode",
          "timezone"
        ],
        "description": "A country Hagz operates in."
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Quote it to support."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail"
        ],
        "additionalProperties": {},
        "description": "An error. Extra members depend on the code."
      },
      "VerificationCodeSent": {
        "type": "object",
        "properties": {
          "expiresIn": {
            "type": "integer",
            "description": "Seconds the code stays valid.",
            "example": 600
          },
          "resendAfter": {
            "type": "integer",
            "description": "Seconds before another code can be sent.",
            "example": 60
          }
        },
        "required": [
          "expiresIn",
          "resendAfter"
        ],
        "description": "Returned whether or not the number has an account."
      },
      "SendVerificationCode": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Mobile number with its country code.",
            "example": "+20 100 123 4567"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerificationConfirmed": {
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "description": "Single use. Proves the phone belongs to the caller."
          },
          "expiresIn": {
            "type": "integer",
            "example": 900
          }
        },
        "required": [
          "verificationToken",
          "expiresIn"
        ]
      },
      "ConfirmVerificationCode": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Mobile number with its country code.",
            "example": "+20 100 123 4567"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "CustomerAuthenticated": {
        "type": "object",
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          }
        },
        "required": [
          "customer",
          "session"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "example": "+201001234567"
          },
          "language": {
            "type": "string",
            "enum": [
              "AR",
              "EN"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "language"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "description": "Seconds.",
            "example": 600
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresIn": {
            "type": "integer",
            "description": "Seconds; extended by every refresh.",
            "example": 5184000
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresIn"
        ]
      },
      "CustomerSignUp": {
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Ahmed"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "The device's IANA time zone.",
            "example": "Africa/Cairo"
          }
        },
        "required": [
          "verificationToken",
          "name",
          "password",
          "timezone"
        ]
      },
      "TwoFactorChallenge": {
        "type": "object",
        "properties": {
          "twoFactorRequired": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "challengeToken": {
            "type": "string",
            "description": "Proves the password was right. Not an access token."
          },
          "expiresIn": {
            "type": "integer",
            "example": 600
          },
          "resendAfter": {
            "type": "integer",
            "example": 60
          }
        },
        "required": [
          "twoFactorRequired",
          "challengeToken",
          "expiresIn",
          "resendAfter"
        ]
      },
      "CustomerSignIn": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Mobile number with its country code.",
            "example": "+20 100 123 4567"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "CompleteTwoFactor": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": [
          "challengeToken",
          "code"
        ]
      },
      "ResendTwoFactor": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "challengeToken"
        ]
      },
      "RefreshSession": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RequestPasswordReset": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Mobile number with its country code.",
            "example": "+20 100 123 4567"
          }
        },
        "required": [
          "phone"
        ]
      },
      "ConfirmPasswordReset": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Mobile number with its country code.",
            "example": "+20 100 123 4567"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "phone",
          "code",
          "newPassword"
        ]
      },
      "TwoFactorStatus": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ]
      },
      "ChangeTwoFactor": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": [
          "enabled",
          "code"
        ],
        "description": "Needs a code from POST two-factor/codes."
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/marketplaces": {
      "get": {
        "tags": [
          "Locations"
        ],
        "summary": "List the countries Hagz operates in",
        "description": "Names follow `Accept-Language` (`ar` or `en`, Arabic by default). Public.",
        "responses": {
          "200": {
            "description": "Active marketplaces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Marketplace"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable; retry.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/verifications": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Send a sign-up code over WhatsApp",
        "description": "The same response whether or not the number has an account. Language follows `Accept-Language`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendVerificationCode"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Code sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationCodeSent"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_PHONE_NUMBER: not a mobile number in international format.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: too many codes; see `retryAfter`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE or MESSAGING_UNAVAILABLE: retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/verifications/confirm": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Confirm a sign-up code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmVerificationCode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The phone is verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationConfirmed"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_CODE (with `attemptsLeft`) or CODE_EXPIRED: ask for a new code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/sign-up": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Create the account and sign in",
        "description": "Needs a `verificationToken` from confirming a code. Language follows `Accept-Language`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerSignUp"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signed up and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerAuthenticated"
                }
              }
            }
          },
          "400": {
            "description": "VERIFICATION_TOKEN_INVALID: verify the number again; or VALIDATION_FAILED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "PHONE_ALREADY_REGISTERED: log in instead.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: retry with the same verificationToken.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/sessions": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Sign in with phone and password",
        "description": "With two-factor on, a right password returns 200 with a `challengeToken` and sends a code; finish with POST sessions/two-factor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerSignIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password right; a two-factor code was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwoFactorChallenge"
                }
              }
            }
          },
          "201": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerAuthenticated"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS: the same for an unknown number and a wrong password.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_SUSPENDED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE or MESSAGING_UNAVAILABLE: retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/sessions/two-factor": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Finish a two-factor sign-in with the code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteTwoFactor"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerAuthenticated"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_CODE (with `attemptsLeft`) or CODE_EXPIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "CHALLENGE_EXPIRED: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_SUSPENDED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/sessions/two-factor/resend": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Send another two-factor code",
        "description": "Returns a new `challengeToken`: the previous one belonged to the previous code.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendTwoFactor"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "A new code was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwoFactorChallenge"
                }
              }
            }
          },
          "401": {
            "description": "CHALLENGE_EXPIRED: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see `retryAfter`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE or MESSAGING_UNAVAILABLE: retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/sessions/refresh": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Exchange the refresh token for a new pair",
        "description": "The refresh token rotates: store the new one. Send one refresh at a time; for 30 s the previous token is still answered with the same new pair, so a lost response can be retried.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSession"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new access and refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "SESSION_ENDED: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: retry with the same refresh token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/sessions/current": {
      "delete": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Sign out of this device",
        "description": "The access token keeps working until it expires (at most 10 minutes); the refresh token stops at once.",
        "security": [
          {
            "customerBearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "UNAUTHENTICATED or TOKEN_EXPIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/password-resets": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Send a password reset code",
        "description": "The same response whether or not the number has an account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordReset"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "If the number has an account, a code was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationCodeSent"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_PHONE_NUMBER",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see `retryAfter`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE or MESSAGING_UNAVAILABLE: retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/password-resets/confirm": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Set a new password with the reset code",
        "description": "Signs out every session; sign in again with the new password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmPasswordReset"
              }
            }
          }
        },
        "responses": {
          "204": {
