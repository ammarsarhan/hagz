{
  "openapi": "3.1.0",
  "info": {
    "title": "Hagz API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Marketplace": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "ISO 3166-1 alpha-2.",
            "example": "EG"
          },
          "name": {
            "type": "string",
            "description": "In the requested language.",
            "example": "مصر"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "ISO 4217.",
            "example": "EGP"
          },
          "dialCode": {
            "type": "string",
            "description": "E.164 prefix.",
            "example": "+20"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone.",
            "example": "Africa/Cairo"
          }
        },
        "required": [
          "code",
          "name",
          "currency",
          "dialCode",
          "timezone"
        ],
        "description": "A country Hagz operates in."
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Quote it to support."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail"
        ],
        "additionalProperties": {},
        "description": "An error. Extra members depend on the code."
      },
      "VerificationCodeSent": {
        "type": "object",
        "properties": {
          "expiresIn": {
            "type": "integer",
            "description": "Seconds the code stays valid.",
            "example": 600
          },
          "resendAfter": {
            "type": "integer",
            "description": "Seconds before another code can be sent.",
            "example": 60
          }
        },
        "required": [
          "expiresIn",
          "resendAfter"
        ],
        "description": "Returned whether or not the number has an account."
      },
      "SendVerificationCode": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Mobile number with its country code.",
            "example": "+20 100 123 4567"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerificationConfirmed": {
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "description": "Single use. Proves the phone belongs to the caller."
          },
          "expiresIn": {
            "type": "integer",
            "example": 900
          }
        },
        "required": [
          "verificationToken",
          "expiresIn"
        ]
      },
      "ConfirmVerificationCode": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Mobile number with its country code.",
            "example": "+20 100 123 4567"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "CustomerSignedUp": {
        "type": "object",
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          }
        },
        "required": [
          "customer",
          "session"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "example": "+201001234567"
          },
          "language": {
            "type": "string",
            "enum": [
              "AR",
              "EN"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "language"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "description": "Seconds.",
            "example": 600
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresIn": {
            "type": "integer",
            "description": "Seconds; extended by every refresh.",
            "example": 5184000
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresIn"
        ]
      },
      "CustomerSignUp": {
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Ahmed"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "The device's IANA time zone.",
            "example": "Africa/Cairo"
          }
        },
        "required": [
          "verificationToken",
          "name",
          "password",
          "timezone"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/marketplaces": {
      "get": {
        "tags": [
          "Locations"
        ],
        "summary": "List the countries Hagz operates in",
        "description": "Names follow `Accept-Language` (`ar` or `en`, Arabic by default). Public.",
        "responses": {
          "200": {
            "description": "Active marketplaces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Marketplace"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable; retry.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/verifications": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Send a sign-up code over WhatsApp",
        "description": "The same response whether or not the number has an account. Language follows `Accept-Language`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendVerificationCode"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Code sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationCodeSent"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_PHONE_NUMBER: not a mobile number in international format.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: too many codes; see `retryAfter`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "MESSAGING_UNAVAILABLE or SERVICE_UNAVAILABLE: retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/verifications/confirm": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Confirm a sign-up code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmVerificationCode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The phone is verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationConfirmed"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_CODE (with `attemptsLeft`) or CODE_EXPIRED: ask for a new code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: retry later.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/customer/sign-up": {
      "post": {
        "tags": [
          "Customer auth"
        ],
        "summary": "Create the account and sign in",
        "description": "Needs a `verificationToken` from confirming a code. Language follows `Accept-Language`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerSignUp"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signed up and signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSignedUp"
                }
              }
            }
          },
          "400": {
            "description": "VERIFICATION_TOKEN_INVALID: verify the number again; or VALIDATION_FAILED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "PHONE_ALREADY_REGISTERED: log in instead.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: retry with the same verificationToken.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
