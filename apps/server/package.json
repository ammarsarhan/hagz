{
  "name": "@hagz/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "concurrently -n http,worker \"tsx watch src/app.ts\" \"tsx watch src/worker.ts\"",
    "dev:http": "tsx watch src/app.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start:http": "node dist/app.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.10",
    "dotenv": "^18.0.4",
    "hono": "^4.13.11",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hagz/tsconfig": "workspace:^",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
