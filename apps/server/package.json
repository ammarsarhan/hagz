{
  "name": "@hagz/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n http,worker \"tsx watch src/app.ts\" \"tsx watch src/worker.ts\"",
    "dev:http": "tsx watch src/app.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start:http": "node dist/app.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hagz/contracts": "workspace:^",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.10",
    "dotenv": "^18.0.4",
    "hono": "^4.13.11",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "prisma": "7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hagz/eslint-config": "workspace:^",
    "@hagz/tsconfig": "workspace:^",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
