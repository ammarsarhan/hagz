// A customer's booking at one venue: back-to-back slots on one ground, which point at it through
// GroundSlot.bookingId. Always tied to a VenueCustomer, so walk-in and phone bookings staff enter
// work the same way. groundId, startsAt and endsAt describe the booking on their own, so it keeps
// its history after its slots are released. Amounts are in minor units of the marketplace
// currency; the breakdown is in BookingCharge. Bookings are never deleted.
// CHECKs: endsAt > startsAt, total >= 0, depositAmount set exactly when DEPOSIT and 1–total;
// taxRate 0–10000, taxAmount 0–total and 0 when taxRate is 0.
model Booking {
  id            String        @id @default(uuid(7)) @db.Uuid
  venueId       String        @db.Uuid
  groundId      String        @db.Uuid
  customerId    String        @db.Uuid
  creatorId     String?       @db.Uuid // Staff who entered it; null when the customer booked.
  code          String        @unique // Random public code for the share link, /b/[code].
  status        BookingStatus
  startsAt      DateTime      @db.Timestamptz
  endsAt        DateTime      @db.Timestamptz
  total         Int // Sum of its charges, VAT included.
  taxRate       Int // Basis points, copied at booking time; 0 if the venue has no taxNumber.
  taxAmount     Int // The VAT inside total.
  depositAmount Int? // DEPOSIT: due online, copied at booking time; the rest is paid in cash.
  paymentMode   PaymentMode // Copied from VenueSettings at booking time.
  note          String? // From the customer.
  expiresAt     DateTime?     @db.Timestamptz // PENDING and HELD release their slots after this.
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  venue    Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  ground   Ground          @relation(fields: [groundId, venueId], references: [id, venueId], onDelete: Restrict)
  customer VenueCustomer   @relation(fields: [customerId, venueId], references: [id, venueId], onDelete: Restrict)
  creator  Staff?          @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  slots    GroundSlot[]
  charges  BookingCharge[]
  payments Payment[]
  events   BookingEvent[]

  @@unique([id, venueId]) // GroundSlot relation target.
  @@index([venueId, startsAt])
  @@index([groundId, startsAt])
  @@index([customerId, startsAt])
  @@index([status, expiresAt])
}

// The price at booking time, VAT included, one row per line: each hour, each amenity, and any
// discount. Written once with the booking and never changed, so later price edits don't touch it;
// Booking.total is their sum. Cancellations and refunds are not charges: they're handled by the
// cancellation policy and the payment ledger, which records only money that actually moved.
// One SLOT row per hour and one AMENITY row per option.
// CHECK: SLOT has startsAt and tier, AMENITY has optionId (and pricing unless free), both with
// amount >= 0; DISCOUNT has none of them and amount < 0.
model BookingCharge {
  id        String            @id @default(uuid(7)) @db.Uuid
  bookingId String            @db.Uuid
  type      BookingChargeType
  startsAt  DateTime?         @db.Timestamptz // SLOT: the hour.
  tier      PriceTier? // SLOT
  optionId  String?           @db.Uuid // AMENITY
  pricing   AmenityPricing? // AMENITY; null when free.
  amount    Int // Per-hour amenities already multiplied out. Negative for DISCOUNT.
  createdAt DateTime          @default(now()) @db.Timestamptz

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  option  AmenityOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([bookingId, startsAt])
  @@unique([bookingId, optionId])
  @@index([optionId])
}

// Append-only booking history, written in the same transaction as the change. At most one actor;
// none means the system (e.g. the expiry job). The migration adds
// CHECK (num_nonnulls("staffId", "customerId", "adminId") <= 1).
model BookingEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  bookingId  String   @db.Uuid
  type       String // The allowed list lives in the API.
  staffId    String?  @db.Uuid
  customerId String?  @db.Uuid
  adminId    String?  @db.Uuid
  data       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}
