// Admin-managed amenity catalog per marketplace.
model AmenityOption {
  id            String   @id @default(uuid(7)) @db.Uuid
  marketplaceId String   @db.Uuid
  key           String // Stable code, e.g. parking.
  isActive      Boolean  @default(true) // Inactive options can't be newly picked.
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  marketplace  Marketplace          @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  translations AmenityTranslation[]
  venues       VenueAmenity[]
  charges      BookingCharge[]

  @@unique([marketplaceId, key])
  @@unique([id, marketplaceId])
}

model AmenityTranslation {
  optionId String   @db.Uuid
  language Language
  name     String

  option AmenityOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, language])
}
