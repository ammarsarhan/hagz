// Marketplace must match the location's. The team, owner included, is in VenueMembership.
model Venue {
  id            String                                 @id @default(uuid(7)) @db.Uuid
  marketplaceId String                                 @db.Uuid
  locationId    String                                 @db.Uuid
  slug          String                                 @unique // /venue/[slug]
  status        VenueStatus                            @default(DRAFT)
  placeId       String?
  phone         String? // E.164 contact number shown to customers.
  // Owner's map pin, written with raw SQL. Optional for drafts (and so Prisma can create rows).
  coordinates   Unsupported("geography(Point, 4326)")?
  // Recalculated from visible reviews in the same transaction as every review change.
  averageRating Decimal?                               @db.Decimal(3, 2) // Null until the first review.
  reviewCount   Int                                    @default(0)
  createdAt     DateTime                               @default(now()) @db.Timestamptz
  updatedAt     DateTime                               @updatedAt @db.Timestamptz

  marketplace  Marketplace        @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  location     Location           @relation(fields: [locationId, marketplaceId], references: [id, marketplaceId], onDelete: Restrict)
  translations VenueTranslation[]
  memberships  VenueMembership[]
  invitations  VenueInvitation[]
  settings     VenueSettings?
  amenities    VenueAmenity[]
  media        VenueMedia[]
  events       VenueEvent[]
  favorites    VenueFavorite[]
  customers    VenueCustomer[]
  grounds      Ground[]
  layout       VenueLayout?
  bookings     Booking[]

  @@unique([id, marketplaceId])
  @@index([coordinates], type: Gist)
  @@index([locationId])
  @@index([marketplaceId, status])
  @@index([marketplaceId, averageRating])
}

// At least one language required (API); admins add the rest.
model VenueTranslation {
  venueId     String   @db.Uuid
  language    Language
  name        String
  description String
  address     String

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([venueId, language])
  @@index([language, name])
}

// One OWNER per venue (partial index). Create venues and transfer ownership in a transaction;
// Restrict on staff keeps a venue from losing its owner.
model VenueMembership {
  venueId     String    @db.Uuid
  staffId     String    @db.Uuid
  role        VenueRole @default(MEMBER)
  permissions Json
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@id([venueId, staffId])
  @@unique([venueId], map: "VenueMembership_owner_key", where: { role: "OWNER" })
  @@index([staffId])
}

// Single-use 48h join code for one phone; the acceptor's verified phone must match. One open code
// per phone per venue (partial index); resending revokes the old one.
model VenueInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  venueId     String    @db.Uuid
  phone       String // E.164, matched exactly against Staff.phone.
  codeHash    String    @unique // HMAC-SHA256, so typed codes can be looked up.
  permissions Json // Defaults from VenueSettings.
  invitorId   String    @db.Uuid
  expiresAt   DateTime  @db.Timestamptz
  acceptedAt  DateTime? @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  invitor Staff @relation(fields: [invitorId], references: [id], onDelete: Restrict)

  @@unique([venueId, phone], map: "VenueInvitation_open_key", where: { acceptedAt: null, revokedAt: null })
  @@index([phone])
}

// One row per venue. CHECKs: depositPercent set exactly when DEPOSIT, 1–99; paymentWindow > 0.
model VenueSettings {
  venueId            String      @id @db.Uuid
  defaultPermissions Json // For new invitations.
  minimumNotice      Int         @default(60) // Minutes before kick-off that booking closes.
  autoConfirm        Boolean     @default(true) // False: staff approve each booking.
  paymentMode        PaymentMode @default(MANUAL)
  depositPercent     Int? // DEPOSIT: share of the total paid online.
  paymentWindow      Int? // Minutes a HELD booking waits for payment; null uses the platform default.
  createdAt          DateTime    @default(now()) @db.Timestamptz
  updatedAt          DateTime    @updatedAt @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

// An amenity a venue offers; the option must be from the venue's marketplace. Free unless priced.
model VenueAmenity {
  venueId       String          @db.Uuid
  optionId      String          @db.Uuid
  marketplaceId String          @db.Uuid
  price         Int? // Minor units of the marketplace currency.
  pricing       AmenityPricing?

  venue  Venue         @relation(fields: [venueId, marketplaceId], references: [id, marketplaceId], onDelete: Cascade)
  option AmenityOption @relation(fields: [optionId, marketplaceId], references: [id, marketplaceId], onDelete: Restrict)

  @@id([venueId, optionId])
  @@index([optionId])
}

// Photos and videos in object storage. Lowest position is the cover.
model VenueMedia {
  id          String      @id @default(uuid(7)) @db.Uuid
  venueId     String      @db.Uuid
  key         String      @unique // Object storage key.
  type        MediaType
  contentType String
  status      MediaStatus @default(PENDING)
  position    Int
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, position])
}

// Append-only venue history, written in the same transaction as the change. Exactly one actor:
// the migration adds CHECK (num_nonnulls("staffId", "adminId") = 1), which Prisma can't declare.
// Actors are Restrict, not SetNull: accounts are soft-deleted, and SetNull would break the check.
model VenueEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  venueId   String   @db.Uuid
  type      String // The allowed list lives in the API.
  staffId   String?  @db.Uuid
  adminId   String?  @db.Uuid
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([venueId, createdAt])
  @@index([venueId, type])
}

model VenueFavorite {
  customerId String   @db.Uuid
  venueId    String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([customerId, venueId])
  @@index([venueId])
}

// A customer as a venue sees them: an account holder, or a walk-in/phone customer staff entered
// (no customerId), linked by phone if they sign up later. Reviews hang off it, loyalty will later.
// Customers are soft-deleted, so Restrict keeps the venue's history.
model VenueCustomer {
  id         String   @id @default(uuid(7)) @db.Uuid
  venueId    String   @db.Uuid
  customerId String?  @db.Uuid
  name       String
  phone      String? // E.164. Null after the linked account is deleted.
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  venue    Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  review   VenueReview?
  bookings Booking[]

  @@unique([venueId, customerId])
  @@unique([venueId, phone])
  @@unique([id, venueId]) // VenueReview and Booking relation target.
  @@index([customerId])
}

// One per VenueCustomer, editable; not translated. Needs an account and, once bookings exist, a
// completed booking. The migration adds CHECK (rating BETWEEN 1 AND 5).
model VenueReview {
  customerId String    @db.Uuid
  venueId    String    @db.Uuid
  rating     Int       @db.SmallInt
  comment    String?
  language   Language? // Language of the comment.
  hiddenAt   DateTime? @db.Timestamptz // Hidden by an admin.
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  customer VenueCustomer @relation(fields: [customerId, venueId], references: [id, venueId], onDelete: Cascade)

  @@id([customerId, venueId])
  @@index([venueId, createdAt])
}
