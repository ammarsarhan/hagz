// Players. Phone + password (+ optional 2FA).
model Customer {
  id               String        @id @default(uuid(7)) @db.Uuid
  name             String
  phone            String?       @unique // E.164. Null only after deletion (CHECK).
  passwordHash     String
  avatarKey        String?
  twoFactorEnabled Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  phoneVerifiedAt  DateTime?     @db.Timestamptz
  lastLoginAt      DateTime?     @db.Timestamptz
  deletedAt        DateTime?     @db.Timestamptz
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  // Preferences
  language    Language @default(AR)
  timezone    String // IANA, from the device at sign-up (phones can be foreign).
  venueOffers Boolean  @default(false) // Opted in to offer pushes from venues they've played at.
  nearbyGames Boolean  @default(false) // Opted in to pushes about listings near them.

  sessions      CustomerSession[]
  challenges    CustomerVerification[]
  favorites     VenueFavorite[]
  venues        VenueCustomer[]
  bookingEvents BookingEvent[]
  notifications Notification[]
  waitlists     SlotWaitlist[]
  games         ListingPlayer[] // Listings joined.
}

// Same as StaffSession.
model CustomerSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  customerId       String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  pushToken        String?   @unique // Expo; cleared on revoke.
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz
  expiresAt        DateTime  @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// Same as StaffVerification.
model CustomerVerification {
  id         String              @id @default(uuid(7)) @db.Uuid
  customerId String              @db.Uuid
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime            @db.Timestamptz
  consumedAt DateTime?           @db.Timestamptz
  createdAt  DateTime            @default(now()) @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose, createdAt])
}
