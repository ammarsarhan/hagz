// Dashboard users. Phone + password (+ optional 2FA); phone verified over WhatsApp.
// Anyone can sign up; joining another venue needs a VenueInvitation.
model Staff {
  id               String        @id @default(uuid(7)) @db.Uuid
  name             String
  phone            String?       @unique // E.164, e.g. +201001234567. Null only after deletion (migration CHECK).
  passwordHash     String
  language         Language      @default(AR)
  twoFactorEnabled Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  phoneVerifiedAt  DateTime?     @db.Timestamptz
  lastLoginAt      DateTime?     @db.Timestamptz
  deletedAt        DateTime?     @db.Timestamptz
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  sessions    StaffSession[]
  challenges  StaffVerification[]
  memberships VenueMembership[]
  invites     VenueInvitation[]
  events      VenueEvent[]
}

// Same as AdminSession.
model StaffSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  staffId          String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz
  expiresAt        DateTime  @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

// WhatsApp one-time code (stored hashed). Spent when consumed or out of attempts; recent rows
// rate-limit resends.
model StaffVerification {
  id         String              @id @default(uuid(7)) @db.Uuid
  staffId    String              @db.Uuid
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime            @db.Timestamptz
  consumedAt DateTime?           @db.Timestamptz
  createdAt  DateTime            @default(now()) @db.Timestamptz

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, purpose, createdAt])
}
