// A cinema-style grid for multi-ground venues; single-ground venues have none. Each cell is about
// 10 m, so the grid grows with the venue (up to 60 × 60) and the apps pan and zoom it. The layout
// is a diagram: grounds snap to horizontal or vertical. Saved in one transaction; the API checks
// bounds and overlaps. CHECKs: columns and rows 1–60.
model VenueLayout {
  venueId   String   @id @db.Uuid
  columns   Int
  rows      Int
  entrances Json     @default("[]") // Edge markers, e.g. [{ "side": "BOTTOM", "offset": 3 }]
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  venue Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items VenueLayoutItem[]
}

// A tile, placed by its top-left cell. Ground tiles have no width or height: the footprint comes
// from the ground's sport and size (fixed table in code), swapped when VERTICAL. Other tiles are
// sized by the owner. CHECKs: x, y >= 0; GROUND tiles have groundId and orientation and no size;
// other tiles have no groundId or orientation and a size of 1–4 × 1–4.
model VenueLayoutItem {
  id          String             @id @default(uuid(7)) @db.Uuid
  venueId     String             @db.Uuid
  type        LayoutItemType
  groundId    String?            @db.Uuid
  x           Int
  y           Int
  orientation GroundOrientation?
  width       Int?
  height      Int?
  createdAt   DateTime           @default(now()) @db.Timestamptz
  updatedAt   DateTime           @updatedAt @db.Timestamptz

  layout VenueLayout @relation(fields: [venueId], references: [venueId], onDelete: Cascade)
  ground Ground?     @relation(fields: [groundId, venueId], references: [id, venueId], onDelete: Cascade)

  @@unique([groundId, venueId]) // Each ground placed at most once.
  @@index([venueId])
}
