# apps/server
# development | staging | production
APP_ENV=development
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
DATABASE_URL=postgresql://hagz:hagz@localhost:5432/hagz
# Migrations only. On Neon: the direct (non-pooled) URL; DATABASE_URL is the pooled one. Optional locally.
DIRECT_DATABASE_URL=
QUEUE_URL=redis://localhost:6379
CACHE_URL=redis://localhost:6380
# Header the edge proxy puts the caller's IP in, for per-IP rate limits. Leave unset locally;
# set it in an environment only after a spoofed value is shown to be overwritten there.
# CLIENT_IP_HEADER=x-real-ip
# Oldest app builds the API still accepts (major.minor.patch). Older ones get 426.
MIN_CUSTOMER_APP_VERSION=0.0.0
MIN_DASHBOARD_APP_VERSION=0.0.0
# Where the admin web app is served (invitation links point here). Unset: invitations return 503.
ADMIN_WEB_URL=http://localhost:3001

# Secrets: no defaults, the server won't start without them. Generate each value with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# JWT signing keys as kid:secret pairs, comma-separated; the first one signs.
JWT_SIGNING_KEYS=
OTP_PEPPER=
# Exactly 32 bytes (the command above).
TOTP_ENCRYPTION_KEY=
